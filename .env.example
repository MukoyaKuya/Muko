DJANGO_ENV=development
SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SITE_URL=http://127.0.0.1:8000
# Uncomment to use PostgreSQL instead of SQLite:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
WHATSAPP_CONTACT_URL=https://wa.me/254717157165?text=Hi%20Muko%2C%20I%27d%20like%20to%20talk%20about%20a%20project.
WHATSAPP_PHONE_DISPLAY=0717 157 165

USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_NOTIFICATION_EMAIL=deltonmukoyakuya@gmail.com

# Visitor analytics: count the same session again after 30 minutes
ANALYTICS_ENABLED=True
# Leave bot tracking off unless it is specifically needed for reporting.
TRACK_BOT_VISITS=False
# Enable only behind a trusted CDN that sets CF-IPCountry.
TRUST_GEO_HEADERS=False
# Optional local MaxMind GeoLite2-Country database; do not place it in the public web root.
# GEOIP_DATABASE_PATH=/absolute/path/to/GeoLite2-Country.mmdb
VISITOR_TRACKING_COOLDOWN_SECONDS=1800
# Run `python manage.py prune_visitor_logs` daily to enforce this retention period.
VISITOR_LOG_RETENTION_DAYS=90
# Enable only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_X_FORWARDED_FOR=False

# Contact anti-spam rate limit. A shared cache backend is required if the app uses
# multiple worker processes or servers.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
